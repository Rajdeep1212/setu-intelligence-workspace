{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "setu.traffic-offences/v1",
  "title": "SETU state traffic offence table",
  "description": "One file per state. Central statutory penalties and state compounding amounts under MV Act 1988 s.200(1), each tied to an official source. A state amount is filled only when a s.200 notification was read and verified; otherwise the amounts list is empty and status is UNVERIFIED. Observations record other official material (for example a police fine schedule) and never populate state amounts.",
  "type": "object",
  "required": ["schema_version", "jurisdiction", "jurisdiction_name", "retrieved_at", "sources", "offences"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "setu.traffic-offences/v1"},
    "jurisdiction": {"type": "string", "pattern": "^IN-[A-Z]{2}$"},
    "jurisdiction_name": {"type": "string", "minLength": 1},
    "retrieved_at": {"type": "string", "format": "date"},
    "notes": {"type": "array", "items": {"type": "string"}},
    "sources": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/source"}
    },
    "offences": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/offence"}
    }
  },
  "$defs": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "source": {
      "type": "object",
      "required": ["title", "issuer", "kind", "notification_reference", "url", "sha256", "retrieved_at"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "issuer": {"type": "string", "minLength": 1},
        "kind": {"enum": ["central_act", "central_notification", "central_regulation", "state_s200_notification", "police_schedule", "superseded_notification"]},
        "notification_reference": {"type": "string", "minLength": 1},
        "notification_date": {"$ref": "#/$defs/date"},
        "effective_from": {"$ref": "#/$defs/date"},
        "url": {"type": "string", "pattern": "^https://"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "retrieved_at": {"$ref": "#/$defs/date"},
        "provenance_note": {"type": "string"}
      }
    },
    "amount": {
      "type": "object",
      "required": ["occurrence", "vehicle_class", "inr"],
      "additionalProperties": false,
      "properties": {
        "occurrence": {"enum": ["first", "subsequent", "any"]},
        "vehicle_class": {"enum": ["any", "two_three_wheeler", "two_three_wheeler_and_lmv", "light_motor_vehicle", "medium_heavy", "heavy_and_others", "others"]},
        "inr": {"type": "integer", "minimum": 1}
      }
    },
    "offence": {
      "type": "object",
      "required": ["offence_id", "label", "central_law", "state_compounding", "observations"],
      "additionalProperties": false,
      "properties": {
        "offence_id": {"enum": ["helmet", "phone_device", "no_licence", "no_insurance", "overspeeding", "red_light", "triple_riding"]},
        "label": {"type": "string", "minLength": 1},
        "central_law": {
          "type": "object",
          "required": ["provision", "penalty_text", "source_id", "effective_from"],
          "additionalProperties": false,
          "properties": {
            "provision": {"type": "string", "minLength": 1},
            "penalty_text": {"type": "string", "minLength": 1},
            "source_id": {"type": "string"},
            "commencement_source_id": {"type": "string"},
            "effective_from": {"$ref": "#/$defs/date"},
            "note": {"type": "string"}
          }
        },
        "state_compounding": {
          "type": "object",
          "required": ["status", "amounts"],
          "additionalProperties": false,
          "properties": {
            "status": {"enum": ["VERIFIED", "UNVERIFIED"]},
            "amounts": {"type": "array", "items": {"$ref": "#/$defs/amount"}},
            "source_id": {"type": "string"},
            "schedule_row": {"type": "string"},
            "effective_from": {"$ref": "#/$defs/date"},
            "effective_to": {"$ref": "#/$defs/date"},
            "additional_consequence": {"type": "string"},
            "note": {"type": "string"},
            "settle_with": {"type": "string"}
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["source_id", "row", "summary"],
            "additionalProperties": false,
            "properties": {
              "source_id": {"type": "string"},
              "row": {"type": "string"},
              "summary": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
