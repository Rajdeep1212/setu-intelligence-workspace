# Demo is the safe default. "local" accepts an HTTP loopback origin only.
# "cloud" is reserved for Milestone 4A-3 and intentionally fails closed.
SETU_DATA_MODE=demo
# Server-only. Example for an explicitly enabled local integration:
# SETU_BACKEND_URL=http://127.0.0.1:8000
SETU_BACKEND_URL=
# Server-only. Load from the existing local environment; never commit a value.
SETU_BACKEND_API_KEY=
