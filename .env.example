POSTGRES_USER=setu
POSTGRES_PASSWORD=setu
POSTGRES_DB=setu

# The API accepts either DATABASE_URL (used by local Compose) or the
# component fields below. Cloud Run leaves DATABASE_URL unset and supplies a
# DATABASE_UNIX_SOCKET plus DATABASE_PASSWORD from Secret Manager.
DATABASE_URL=
DATABASE_USER=setu
DATABASE_PASSWORD=setu
DATABASE_NAME=setu
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_UNIX_SOCKET=

# Required for /ready and /query: configure at least one provider.
# Never commit real keys. Groq takes precedence if both are configured.
GROQ_API_KEY=
GEMINI_API_KEY=

# Required by POST /query. Generate a strong random value and send it only
# through the X-API-Key request header. Never commit the real value.
SETU_API_KEY=

# Single-process MVP rate limit for POST /query.
QUERY_RATE_LIMIT=10
QUERY_RATE_WINDOW_SECONDS=60
MAX_REQUEST_BODY_BYTES=16384

# Groq's finite SDK request policy. These defaults preserve the validated
# behavior while making the deployment timeout/retry budget explicit.
GROQ_REQUEST_TIMEOUT_SECONDS=600
GROQ_CONNECT_TIMEOUT_SECONDS=5
GROQ_MAX_RETRIES=2

# Bounded SQLAlchemy connection-pool behavior for one API process.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# Comma-separated exact origins. Wildcards are rejected.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Week 5+: observability
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
MLFLOW_TRACKING_URI=./mlruns

# Local retrieval inference. PyTorch remains the safe default.
# Before selecting openvino, run the documented one-time artifact export.
LOCAL_INFERENCE_BACKEND=pytorch
OPENVINO_MODEL_DIR=/models/openvino
